# Stellar admin secret. Two ways to provide it (see backend/src/config.rs):
#   1. STELLAR_ADMIN_KEY_FILE=/path/to/secret  — preferred for production
#   2. STELLAR_ADMIN_KEY=S...                  — acceptable for local dev only
# Never commit a real secret to the repo. The placeholder below is illustrative.
STELLAR_ADMIN_KEY=S_REPLACE_WITH_REAL_STELLAR_SECRET_KEY
